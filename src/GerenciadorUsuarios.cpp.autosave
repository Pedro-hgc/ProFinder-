GerenciadorUsuarios::GerenciadorUsuarios(QObject *parent) : QObject(parent), m_usuarioLogado(nullptr) {
    inicializarBanco();
}

GerenciadorUsuarios::~GerenciadorUsuarios() {
    if(m_db.isOpen())
        m_db.close();
}

void GerenciadorUsuarios::inicializarBanco() {
    m_db = QSqlDatabase::addDatabase("QSQLITE");
    m_db.setDatabaseName("profinder_db.db");
    if (!m_db.open())
        return;

}

void GerenciadorUsuarios::sincronizarVetorComBanco() {
    qDeleteAll(m_usuarios);
    m_usuarios.clear();
    QSqlQuery query("SELECT * FROM usuarios");
    while (query.next()) {
        QString tipo = query.value("tipo").toString();
        if (tipo == "Cliente") {
            m_usuarios.append(new Cliente(query.value("nome").toString(), query.value("email").toString(), query.value("cpf").toString(), query.value("data_nascimento").toString(), query.value("foto_perfil").toString()));
        } else {
            m_usuarios.append(new Fornecedor(query.value("nome").toString(), query.value("email").toString(), query.value("cpf").toString(), query.value("data_nascimento").toString(), query.value("foto_perfil").toString(), query.value("cpf_cnpj").toString(), query.value("certificado").toString(), QStringList(), query.value("descricao").toString(), QMap<QString, int>()));
        }
    }
}


bool GerenciadorUsuarios::cadastrarCliente(const QString& nome, const QString& email, const QString& cpf, const QString& dataNascimento, const QString& fotoPerfil) {
    QSqlQuery query;
    query.prepare("INSERT INTO usuarios (tipo, nome, email, cpf, data_nascimento, foto_perfil) VALUES ('Cliente', ?, ?, ?, ?, ?)");
    query.addBindValue(nome); query.addBindValue(email); query.addBindValue(cpf); query.addBindValue(dataNascimento); query.addBindValue(fotoPerfil);
    if (query.exec()) {
        sincronizarVetorComBanco();
        emit dadosAlterados();
        return true;
    }
    return false;
}

bool GerenciadorUsuarios::cadastrarFornecedor(const QString& nome, const QString& email, const QString& cpf, const QString& dataNascimento, const QString& fotoPerfil, const QString& cpfCnpj, const QString& certificado, const QStringList& fotosServico, const QString& descricao, const QVariantMap& servicos) {
    QSqlQuery query;
    query.prepare("INSERT INTO usuarios (tipo, nome, email, cpf, data_nascimento, foto_perfil, cpf_cnpj, certificado, descricao) VALUES ('Fornecedor', ?, ?, ?, ?, ?, ?, ?, ?)");
    query.addBindValue(nome); query.addBindValue(email); query.addBindValue(cpf); query.addBindValue(dataNascimento); query.addBindValue(fotoPerfil); query.addBindValue(cpfCnpj); query.addBindValue(certificado); query.addBindValue(descricao);
    if (query.exec()) {
        sincronizarVetorComBanco();
        emit fornecedorAdicionado();
        emit dadosAlterados();
        return true;
    }
    return false;
}

QVariantMap GerenciadorUsuarios::fazerLogin(const QString& email, const QString& cpf) {
    QVariantMap res; res["sucesso"] = false;
    for (Usuario* u : m_usuarios) {
        if (u->getEmail() == email && u->getCpf() == cpf) {
            m_usuarioLogado = u;
            res["sucesso"] = true; res["tipo"] = u->getTipo(); res["nome"] = u->getNome();
            return res;
        }
    }
    return res;
}

int GerenciadorUsuarios::getQuantidadeUsuarios() const { return m_usuarios.size(); }
int GerenciadorUsuarios::getQuantidadeFornecedores() const {
    int count = 0;
    for (Usuario* u : m_usuarios) if (u->getTipo() == "Fornecedor") count++;
    return count;
}


QVariantList GerenciadorUsuarios::buscarFornecedoresComIndices(const QString& termo) {
    QVariantList lista;
    for (int i = 0; i < m_usuarios.size(); ++i) {
        if (m_usuarios[i]->getTipo() == "Fornecedor") {
            Fornecedor* f = static_cast<Fornecedor*>(m_usuarios[i]);
            if (termo.isEmpty() || f->getNome().contains(termo, Qt::CaseInsensitive)) {
                QVariantMap item; item["display"] = f->getNome(); item["index"] = i; item["nome"] = f->getNome();
                lista.append(item);
            }
        }
    }
    return lista;
}
QVariantMap GerenciadorUsuarios::obterDetalhesFornecedor(int index) {
    if (index < 0 || index >= m_usuarios.size()) return QVariantMap();
    Fornecedor* f = dynamic_cast<Fornecedor*>(m_usuarios[index]);
    if (!f) return QVariantMap();
    QVariantMap d; d["nome"] = f->getNome(); d["email"] = f->getEmail(); d["descricao"] = f->getDescricaoTrabalho();
    return d;
}

QVariantMap GerenciadorUsuarios::getUsuarioLogado() {
    QVariantMap res; res["logado"] = (m_usuarioLogado != nullptr);
    if (m_usuarioLogado) { res["nome"] = m_usuarioLogado->getNome(); res["tipo"] = m_usuarioLogado->getTipo(); }
    return res;
}

void GerenciadorUsuarios::fazerLogout() { m_usuarioLogado = nullptr; }

int GerenciadorUsuarios::getIndiceFornecedor(const QString& nome) {
    for(int i=0; i < m_usuarios.size(); ++i) if(m_usuarios[i]->getNome() == nome) return i;
    return -1;
}

QStringList GerenciadorUsuarios::buscarFornecedores(const QString& termo) {
    QStringList nomes;
    for(Usuario* u : m_usuarios) if(u->getTipo() == "Fornecedor" && u->getNome().contains(termo, Qt::CaseInsensitive)) nomes << u->getNome();
    return nomes;
}
